{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src/client",
    "noEmit": true,
    "declaration": false,
    "removeComments": true,
    "rewriteRelativeImportExtensions": true,
    "types": []
  },
  "include": ["src/client"]
}
