diff --git a/native/Sources/CUADaemonCore/PointerGuard.swift b/native/Sources/CUADaemonCore/PointerGuard.swift
new file mode 100644
index 0000000..ca73013
--- /dev/null
+++ b/native/Sources/CUADaemonCore/PointerGuard.swift
@@ -0,0 +1,26 @@
+import CoreGraphics
+import Foundation
+
+/// Keeps coordinate-based pointer actions inside the target app's windows.
+///
+/// Coordinates from the model are global screen points and are posted as
+/// real CGEvents, so an out-of-window point clicks whatever else is on screen
+/// (observed: a model passing screenshot *pixel* coordinates clicked the
+/// desktop). Such actions are rejected instead of executed.
+public enum PointerGuard {
+    /// Whether `point` lies inside (or on the edge of) any of `windows`.
+    public static func allows(_ point: CGPoint, windows: [CGRect]) -> Bool {
+        windows.contains { rect in
+            point.x >= rect.minX && point.x <= rect.maxX && point.y >= rect.minY && point.y <= rect.maxY
+        }
+    }
+
+    /// The error text returned to the model when a point is rejected.
+    public static func rejection(_ point: CGPoint, app: String, windows: [CGRect]) -> String {
+        let format = { (v: CGFloat) in String(Int(v.rounded())) }
+        let boxes = windows.map { "[x \(format($0.minX))...\(format($0.maxX)), y \(format($0.minY))...\(format($0.maxY))]" }
+        let listed = boxes.isEmpty ? "no on-screen window" : boxes.joined(separator: ", ")
+        return "coordinate (\(format(point.x)), \(format(point.y))) is outside \(app)'s windows \(listed); "
+            + "x/y are global screen points, not screenshot pixels. Use element_index, or a point inside the window."
+    }
+}
diff --git a/native/Tests/CUADaemonCoreTests/PointerGuardTests.swift b/native/Tests/CUADaemonCoreTests/PointerGuardTests.swift
new file mode 100644
index 0000000..9a825ce
--- /dev/null
+++ b/native/Tests/CUADaemonCoreTests/PointerGuardTests.swift
@@ -0,0 +1,35 @@
+import CoreGraphics
+import XCTest
+@testable import CUADaemonCore
+
+final class PointerGuardTests: XCTestCase {
+    private let window = CGRect(x: 80, y: 80, width: 960, height: 712)
+
+    func testInsideAndEdgesAllowed() {
+        XCTAssertTrue(PointerGuard.allows(CGPoint(x: 500, y: 400), windows: [window]))
+        XCTAssertTrue(PointerGuard.allows(CGPoint(x: 80, y: 80), windows: [window]))
+        XCTAssertTrue(PointerGuard.allows(CGPoint(x: 1040, y: 792), windows: [window]))
+    }
+
+    func testOutsideRejected() {
+        // A screenshot-pixel coordinate (2x) that lands on the desktop.
+        XCTAssertFalse(PointerGuard.allows(CGPoint(x: 1823, y: 112), windows: [window]))
+        XCTAssertFalse(PointerGuard.allows(CGPoint(x: 79, y: 400), windows: [window]))
+    }
+
+    func testAnyOfSeveralWindows() {
+        let second = CGRect(x: 1200, y: 100, width: 300, height: 200)
+        XCTAssertTrue(PointerGuard.allows(CGPoint(x: 1300, y: 150), windows: [window, second]))
+    }
+
+    func testNoWindowsRejectsEverything() {
+        XCTAssertFalse(PointerGuard.allows(CGPoint(x: 500, y: 400), windows: []))
+    }
+
+    func testRejectionMessageNamesPointAndWindow() {
+        let message = PointerGuard.rejection(CGPoint(x: 1823, y: 112), app: "DSHFixture", windows: [window])
+        XCTAssertTrue(message.contains("(1823, 112)"), message)
+        XCTAssertTrue(message.contains("[x 80...1040, y 80...792]"), message)
+        XCTAssertTrue(message.contains("not screenshot pixels"), message)
+    }
+}
