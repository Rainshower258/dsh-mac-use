diff --git a/native/Sources/CUADaemon/Screenshot.swift b/native/Sources/CUADaemon/Screenshot.swift
index 4f8e3b1..a615770 100644
--- a/native/Sources/CUADaemon/Screenshot.swift
+++ b/native/Sources/CUADaemon/Screenshot.swift
@@ -20,6 +20,23 @@ enum Screenshot {
         return (url, "image/png")
     }
 
+    /// Global-point bounds (top-left origin) of every on-screen layer-0 window owned by `pid`.
+    static func windowBounds(pid: pid_t) -> [CGRect] {
+        guard let windows = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID)
+            as? [[String: Any]] else {
+            return []
+        }
+        return windows.compactMap { window in
+            guard let owner = window[kCGWindowOwnerPID as String] as? Int, pid_t(owner) == pid,
+                  let layer = window[kCGWindowLayer as String] as? Int, layer == 0,
+                  let bounds = window[kCGWindowBounds as String] as? [String: CGFloat],
+                  let x = bounds["X"], let y = bounds["Y"], let width = bounds["Width"], let height = bounds["Height"] else {
+                return nil
+            }
+            return CGRect(x: x, y: y, width: width, height: height)
+        }
+    }
