+    /// Coordinates are posted as real CGEvents anywhere on screen; refuse
+    /// points outside the target app's windows rather than click other apps.
+    private func requireInsideWindow(_ point: CGPoint, _ session: AppSession) throws {
+        let windows = Screenshot.windowBounds(pid: session.pid)
+        guard PointerGuard.allows(point, windows: windows) else {
+            throw ComputerUseError.actionFailed(PointerGuard.rejection(point, app: session.bundleID, windows: windows))
+        }
+    }
+
