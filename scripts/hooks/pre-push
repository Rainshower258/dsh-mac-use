#!/bin/zsh
# pre-push: tests + secret, privacy and static scans. Enabled per clone by scripts/install-hooks.sh
# (core.hooksPath=scripts/hooks). Never retries anything: a failure is a failure. Bypass only knowingly
# (git push --no-verify).
# Private patterns (e.g. personal numbers, server IPs) live in .git/info/private-patterns, one fixed string
# per line: that file is inside .git and is never pushed, so the hook never leaks what it guards. Without it
# the privacy check cannot run, so the push is refused.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
fail() { print -u2 "pre-push: FAILED: $1"; exit 1 }
step() { print "pre-push: $1" }

priv=.git/info/private-patterns
[[ -s $priv ]] || fail "$priv is missing or empty: add your private strings (one per line) on this machine first"

# What is pushed (git gives "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin). The tests and scans
# below run on the checkout, so every ref pushed must be its HEAD; a deletion pushes nothing.
zero=0000000000000000000000000000000000000000
refs=$(/bin/cat)
head=$(git rev-parse HEAD)
while read -r lref lsha _rref _rsha; do
  [[ -z $lsha || $lsha == $zero ]] && continue
  [[ $(git rev-parse "$lsha^{commit}") == $head ]] \
    || fail "$lref is not the checked-out commit: the checks run on the checkout, so check it out and push from there"
done <<< "$refs"

step "swift test"
# Capture first: `swift test | grep -q` + pipefail fails spuriously when grep exits early (SIGPIPE).
# A failure keeps the output (2026-10-16: two refusals could not be reproduced by hand; .audit/ is ignored).
# The summary is looked for with a here-string, not `print | grep -q`: under pipefail that pipeline failed now and
# then with every test passed (grep -q exits at the first match, print takes SIGPIPE; the same race the capture
# above avoids). Found 2026-10-17 after the refusal's log showed exit status 0 and the summary line present.
out=$(swift test 2>&1); rc=$?
grep -qE "Executed [0-9]+ tests, with 0 failures" <<< "$out" && (( rc == 0 )) \
  || { mkdir -p .audit; { print "swift test exit status: $rc"; env | grep -E '^GIT_' | sort; print "---"; print -r -- "$out"; } > .audit/pre-push-swift-test.log
       fail "swift test exit $rc (output in .audit/pre-push-swift-test.log)"; }

step "plugin: build + node tests"
[[ -e plugin/node_modules ]] || fail "plugin/node_modules missing: run plugin/scripts/link-deps.sh"
# The documented build (docs/DESIGN.md), not one of its own: the root package.json "build" runs plugin/package.json's, the host
# tsc and then the plugin page (package.json "./client", scripts/build-client.mjs). Before the tests: bundle.test
# checks that every export's file exists.
npm run build >/dev/null 2>&1 || fail "plugin build (npm run build: the host tsc, then the plugin page)"
# plugin/lib is tracked (plugin/.gitignore): an install from the GitHub URL runs the committed build, never builds.
# The build is deterministic, so a diff here is a build not committed with its sources.
git diff --quiet HEAD -- plugin/lib && [[ -z $(git ls-files --others --exclude-standard -- plugin/lib) ]] \
  || fail "plugin/lib differs from the committed build: commit it (npm run build && git add plugin/lib)"
(cd plugin && node --test tests/*.test.mjs >/dev/null 2>&1) || fail "plugin tests (cd plugin && npm test)"

# After the plugin build: test_failclosed boots dsh with plugin/lib.
step "pytest bench/tests"
python3 -m pytest -q bench/tests >/dev/null 2>&1 || fail "pytest bench/tests"

step "gitleaks (full history)"
gitleaks git . --no-banner --redact --config .gitleaks.toml >/dev/null 2>&1 \
  || fail "gitleaks: run 'gitleaks git . --config .gitleaks.toml -v'"

step "semgrep"
semgrep scan --config p/default --config p/python --config p/javascript --config p/secrets --metrics=off --quiet \
  --error $(git ls-files '*.py' '*.js' '*.mjs') >/dev/null 2>&1 || fail "semgrep (rerun without --quiet to see findings)"

step "swiftlint"
swiftlint lint --quiet >/dev/null 2>&1 || fail "swiftlint errors: run 'swiftlint lint'"

step "privacy: tracked files"
# Paths (also JSON-escaped, a backslash before each slash), emails (a TLD in any case), private keys and API keys.
generic='BEGIN [A-Z ]*PRIVATE KEY|sk-[A-Za-z0-9_-]{16,}|/Users/[A-Za-z0-9._-]+|\\/Users\\/[A-Za-z0-9._-]+|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
# Allowed substrings are cut out of a line before it is matched, never the whole line, so a line that also holds
# anything else still fails: GitHub noreply and example addresses, git@github.com, /Users/a1/ (the fixed VM guest
# account, vm-lib.sh GUEST_USER, not a person) and the project's public bug-report address (README "Bug reports").
leaks() {
  perl -ne '(my $s = $_) =~ s{users\.noreply\.github\.com|\@example\.|git\@github\.com|/Users/a1/|\\/Users\\/a1\\/|devinwild48\@gmail\.com}{}g;
            print if $s =~ m{'"$generic"'}'
}
hits=$(git grep -nIE "$generic" HEAD -- . | leaks || true)
[[ -z "$hits" ]] || fail "generic privacy patterns in tracked files:\n$hits"
# Private patterns in any case: a name or number written in another case is the same leak.
n=$(git grep -ciIF -f "$priv" HEAD -- . 2>/dev/null | awk -F: '{s+=$NF} END {print s+0}')
[[ $n -eq 0 ]] || fail "$n private-pattern hit(s) in tracked files (git grep -niIF -f $priv HEAD)"

step "privacy: commits being pushed"
# Every commit pushed, not only HEAD's tree: a path one commit adds and a later one removes stays in the history. The
# commits are those no remote-tracking ref already has (all of them for a new repository); a merge is read against
# its first parent, so a conflict resolution is scanned too.
while read -r _lref lsha _rref _rsha; do
  [[ -z $lsha || $lsha == $zero ]] && continue
  commits=$(git rev-list "$lsha" --not --remotes)
  [[ -n $commits ]] || continue
  bad=$(print -r -- $commits | git log --stdin --no-walk --format='%ae %ce' | tr ' ' '\n' | sort -u \
        | grep -v 'users\.noreply\.github\.com$' || true)
  [[ -z "$bad" ]] || fail "commit author/committer email is not a GitHub noreply address"
  # The added lines, without their leading +, which would otherwise pass for an email's local part.
  added=$(print -r -- $commits | git log --stdin --no-walk -p --diff-merges=first-parent --no-color --format= \
          | sed -n 's/^+//p' | grep -v '^++ ' || true)
  hits=$(print -r -- $added | leaks || true)
  [[ -z "$hits" ]] || fail "generic privacy patterns added by a commit being pushed:\n$hits"
  print -r -- $added | grep -qiF -f "$priv" && fail "private pattern added by a commit being pushed (git log -p)"
  meta=$(print -r -- $commits | git log --stdin --no-walk --format='%an %ae %cn %ce %B')
  hits=$(print -r -- $meta | leaks || true)
  [[ -z "$hits" ]] || fail "generic privacy patterns in commit metadata/messages:\n$hits"
  print -r -- $meta | grep -qiF -f "$priv" && fail "private pattern in commit metadata/messages"
done <<< "$refs"

step "all checks passed"
